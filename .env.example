# ---------------------------------------------------------------------------
# NORS Electric — environment variables
# Copy to .env.local for development, or set these in your host's dashboard.
# Every one of these is OPTIONAL: with none set, the site builds and runs, and
# the form saves leads to disk. You will just not get notified about them.
# ---------------------------------------------------------------------------

# --- Lead notification email (Resend) --------------------------------------
# Sign up at resend.com, verify your sending domain, create an API key.
# Without these, submitted leads are saved to disk but NOT emailed to anyone.
RESEND_API_KEY=
# Where new lead notifications go. Comma-separate for multiple recipients.
LEAD_NOTIFICATION_EMAIL=office@norselectricky.com
# Must be an address on a domain you verified in Resend.
LEAD_FROM_EMAIL=website@norselectricky.com

# --- CRM / automation webhook (optional) -----------------------------------
# Every lead is also POSTed here as JSON. Works with Zapier, Make, n8n,
# Jobber, Housecall Pro, ServiceTitan, or your own endpoint.
LEAD_WEBHOOK_URL=
# Sent as the X-Webhook-Secret header so your endpoint can verify the caller.
LEAD_WEBHOOK_SECRET=

# --- Admin lead inbox (/admin/leads) ---------------------------------------
# HTTP Basic Auth. If EITHER is unset, /admin/leads returns 404 — it fails
# closed rather than exposing customer data on a misconfigured deploy.
# Use a long random password.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Storage ---------------------------------------------------------------
# Where leads.jsonl is written. Point this at a mounted volume when self-hosting
# so the file survives restarts and deploys. Defaults to ./data.
LEADS_DATA_DIR=
